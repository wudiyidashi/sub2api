# =============================================================================
# Sub2API release image
# =============================================================================
# GoReleaser supplies the pre-built gateway binary. The release context also
# contains the pinned Codex account-driver source prepared by the workflow.
# The driver is compiled for the image architecture so the published amd64
# and arm64 images both include HTTP, SSE, and WebSocket account transport.
# =============================================================================

ARG RUNTIME_IMAGE=postgres:18-bookworm

FROM ${RUNTIME_IMAGE}

LABEL maintainer="Wei-Shaw <github.com/Wei-Shaw>"
LABEL description="Sub2API - AI API Gateway Platform"
LABEL org.opencontainers.image.source="https://github.com/Wei-Shaw/sub2api"

# The PostgreSQL base provides version-matched pg_dump/psql tools and gosu is
# used by the account-driver entrypoint to drop privileges before startup.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    tzdata \
    wget \
    gosu \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --gid 1000 sub2api && \
    useradd --uid 1000 --gid 1000 --create-home --shell /bin/sh sub2api

WORKDIR /app

COPY --chown=sub2api:sub2api sub2api /app/sub2api
COPY --chown=sub2api:sub2api backend/resources /app/resources
COPY drivers/sub2api-codex-account-driver /app/drivers/sub2api-codex-account-driver
COPY deploy/docker-entrypoint.account-drivers.sh /app/docker-entrypoint.account-drivers.sh

RUN chmod 0555 /app/sub2api /app/drivers/sub2api-codex-account-driver /app/docker-entrypoint.account-drivers.sh \
    && mkdir -p /app/data \
    && chown -R sub2api:sub2api /app \
    && sha256sum /app/drivers/sub2api-codex-account-driver | cut -d ' ' -f 1 > /app/drivers/codex-rs-http.sha256 \
    && chmod 0444 /app/drivers/codex-rs-http.sha256

ENV ACCOUNT_DRIVERS_CODEX_RS_HTTP_ENABLED=true \
    ACCOUNT_DRIVERS_CODEX_RS_HTTP_EXECUTABLE_PATH=/app/drivers/sub2api-codex-account-driver \
    ACCOUNT_DRIVERS_CODEX_RS_HTTP_START_TIMEOUT_SECONDS=10

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD wget -q -T 5 -O /dev/null http://localhost:${SERVER_PORT:-8080}/health || exit 1

ENTRYPOINT ["/app/docker-entrypoint.account-drivers.sh"]
CMD ["/app/sub2api"]
