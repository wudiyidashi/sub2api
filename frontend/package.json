{
  "name": "sub2api-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "check:i18n": "vitest run src/i18n/__tests__/localeKeyCompleteness.spec.ts",
    "build": "pnpm run check:i18n && vue-tsc -b && vite build && pnpm run build:team-stats && pnpm run build:cpr-console",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "lint:check": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts",
    "typecheck": "vue-tsc --noEmit && pnpm run typecheck:team-stats && pnpm run typecheck:cpr-console",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build:team-stats": "pnpm run typecheck:team-stats && vite build --config subprojects/team-stats/vite.config.ts",
    "typecheck:team-stats": "vue-tsc --noEmit -p subprojects/team-stats/tsconfig.json",
    "test:team-stats": "vitest run --config subprojects/team-stats/vitest.config.ts",
    "build:cpr-console": "node subprojects/cpr-console/run.mjs build",
    "typecheck:cpr-console": "node subprojects/cpr-console/run.mjs typecheck",
    "test:cpr-console": "vitest run --config subprojects/cpr-console/vitest.config.ts",
    "dev:cpr-console": "node subprojects/cpr-console/run.mjs dev"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@airwallex/components-sdk": "^1.30.2",
    "@lobehub/icons": "^4.0.2",
    "@stripe/stripe-js": "^9.0.1",
    "@tanstack/vue-virtual": "^3.13.23",
    "@vueuse/core": "^10.7.0",
    "axios": "^1.20.0",
    "chart.js": "^4.4.1",
    "dompurify": "^3.4.14",
    "driver.js": "^1.4.0",
    "file-saver": "^2.0.5",
    "marked": "^17.0.1",
    "pinia": "^2.1.7",
    "qrcode": "^1.5.4",
    "vue": "^3.5.43",
    "vue-chartjs": "^5.3.0",
    "vue-draggable-plus": "^0.6.1",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.2.5",
    "xlsx": "^0.18.5",
    "echarts": "^5.6.0",
    "vue-echarts": "^7.0.3",
    "html2canvas": "^1.4.1"
  },
  "devDependencies": {
    "@intlify/message-compiler": "9.14.5",
    "@types/dompurify": "^3.0.5",
    "@types/file-saver": "^2.0.7",
    "@types/mdx": "^2.0.13",
    "@types/node": "^20.10.5",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vitest/coverage-v8": "^2.1.9",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.25.0",
    "jsdom": "^24.1.3",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "~5.6.0",
    "vite": "^5.0.10",
    "vite-plugin-checker": "^0.9.1",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.2.0"
  },
  "pnpm": {
    "overrides": {
      "follow-redirects@<1.16.1": ">=1.16.1",
      "js-cookie": "3.0.7",
      "form-data@<4.0.6": ">=4.0.6",
      "postcss@<8.5.18": ">=8.5.18",
      "dompurify@<3.4.14": ">=3.4.14",
      "source-map-js@<1.2.2": ">=1.2.2"
    }
  },
  "packageManager": "pnpm@10.6.0+sha512.df0136e797db0cfa7ec1084e77f3bdf81bacbae9066832fbf95cba4c2140ad05e64f316cde51ce3f99ea00a91ffc702d6aedd3c0f450f895e3e7c052fe573cd8"
}
