+/// 宿主准备身份与请求头的一次原生 WS opening，保留完整 handshake 错误响应
+/// 超时、业务重试、账号与连接复用由宿主负责
+pub async fn connect_prepared_websocket(
+    connection: &CodexWebSocketConnection,
+    max_message_bytes: usize,
+) -> Result<(RawWsStream, WsResponse<Option<Vec<u8>>>), tungstenite::Error> {
+    connect_websocket_transport(connection, false, Some(max_message_bytes)).await
+}
+
+async fn connect_websocket_transport(
+    connection: &CodexWebSocketConnection,
+    fast_path: bool,
+    max_message_bytes: Option<usize>,
+) -> Result<(RawWsStream, WsResponse<Option<Vec<u8>>>), tungstenite::Error> {
+    let request = websocket_handshake_request(connection)?;
+    let connector = tls::maybe_build_rustls_client_config_with_custom_ca()
+        .map_err(|error| tungstenite::Error::Io(std::io::Error::other(error)))?
+        .map(Connector::Rustls);
+    let _permit = if fast_path {
+        crate::transport::connection::try_acquire()
+    } else {
+        crate::transport::connection::acquire().await
+    }
+    .map_err(tungstenite::Error::Io)?;
+    // 保留原生直连握手，显式出口不继承全局代理
+    if connection.outbound_proxy.is_none()
+        && matches!(
+            tungstenite::proxy::ProxyConfig::from_env(request.uri()),
+            Ok(None)
+        )
+    {
+        let (websocket, response) = connect_async_tls_with_config(
+            request,
+            Some(websocket_config(max_message_bytes)),
+            false,
+            connector,
+        )
+        .await?;
+        return Ok((Box::new(websocket) as RawWsStream, response));
+    }
+    let stream = dial_account(connection).await?;
+    match stream {
+        MaybeTlsStream::Plain(tcp) => {
+            let (websocket, response) = client_async_tls_with_config(
+                request,
+                tcp,
+                Some(websocket_config(max_message_bytes)),
+                connector,
+            )
+            .await?;
+            Ok((Box::new(websocket) as RawWsStream, response))
+        }
+        stream => {
+            let (websocket, response) = client_async_tls_with_config(
+                request,
+                stream,
+                Some(websocket_config(max_message_bytes)),
+                connector,
+            )
+            .await?;
+            Ok((Box::new(websocket) as RawWsStream, response))
+        }
+    }
+}
